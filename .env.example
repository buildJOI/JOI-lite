# ─── JOI configuration ────────────────────────────────────────────────────────
# Copy this file to .env and fill in what you need. Only GROQ_API_KEY is
# required for chat; everything else is optional.

# AI brain (required for chat). Free key: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   (llama-3.3-70b-versatile was retired by Groq on 2026-08-16)

# Cloud voice for JOI's replies (optional). https://elevenlabs.io
# Without it, replies are text only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Web search tool (optional). https://serper.dev
SERPER_API_KEY=

# Microphone voice mode: say "JOI ..." to talk to it.
# Needs: pip install -r backend/requirements-optional.txt
JOI_VOICE=0

# Ports (defaults shown)
# JOI_PORT=8000
# JOI_FRONTEND_PORT=5173
